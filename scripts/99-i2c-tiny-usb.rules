# Привязка mainline-драйвера i2c-tiny-usb к нашему VID/PID.
#
# Установка (однократно):
#   sudo install -m 755 scripts/i2c-tiny-usb-bind.sh \
#        /usr/local/bin/i2c-tiny-usb-bind
#   sudo install -m 644 scripts/99-i2c-tiny-usb.rules \
#        /etc/udev/rules.d/99-i2c-tiny-usb.rules
#   sudo udevadm control --reload-rules
#
# После этого при каждом подключении платы появляется /dev/i2c-N.

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="21c2", RUN+="/usr/local/bin/i2c-tiny-usb-bind 1209 21c2"
