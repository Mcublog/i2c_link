{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build active target",
            "command": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild active",
            "command": "cleanRebuild",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Flash: firmware",
            "command": "JLink",
            "dependsOn": "CMake: build active target",
            "args": [
                "-CommanderScript",
                "${command:cmake.launchTargetPath}.jlink"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "type": "shell",
            "label": "Flash: firmware (script)",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                "-o",
                "${workspaceFolder}/build/flash.log"
            ],
            "dependsOn": "CMake: build active target",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "type": "shell",
            "label": "RTT: console (10 s)",
            "command": "${workspaceFolder}/scripts/rtt.sh",
            "args": [
                "-w",
                "10"
            ],
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Delete: build dir",
            "type": "shell",
            "windows": {
                "command": "rm",
                "args": [
                    "build",
                    "-r",
                    "-force"
                ]
            },
            "linux": {
                "command": "rm",
                "args": [
                    "-rf",
                    "build"
                ]
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
